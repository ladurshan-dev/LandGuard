{
  "ConnectionStrings": {
    "LandGuardDB": "Server=localhost\\SQLEXPRESS;Database=LandGuardDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "LandGuard.API",
    "Audience": "LandGuard.Client",
    "Key": "REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "AccessTokenExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5500", "http://127.0.0.1:5500" ]
  },
  "Geocoding": {
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "LandGuard-FYP/1.0 (REPLACE_WITH_A_CONTACT_EMAIL)",
    "TimeoutSeconds": 5
  },
  "FileStorage": {
    "RootPath": "wwwroot/uploads/properties",
    "PublicBaseUrl": "/uploads/properties",
    "MaxFileSizeBytes": 5242880,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "DocumentsRootPath": "App_Data/uploads/documents",
    "MaxDocumentSizeBytes": 15728640,
    "AllowedDocumentContentTypes": [ "application/pdf", "image/jpeg", "image/png", "image/tiff" ]
  },
  "Ocr": {
    "TessDataPath": "tessdata",
    "Language": "eng"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
